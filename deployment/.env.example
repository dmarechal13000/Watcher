#############################################
# DEPLOYMENT (DOCKER COMPOSE) SETTINGS
#
# Copy to .env (git-ignored): cp .env.example .env  (or: make init)
#
# Each variable lives in exactly ONE of the two env files:
# - this file: anything Docker Compose needs (also passed to the watcher container)
# - ../.env (from ../.env.example): Django application settings
#   (DJANGO_SECRET_KEY, DJANGO_DEBUG, ALLOWED_HOSTS, connectors, LDAP/OIDC, ...)
# Do not duplicate a variable across both files: this one is loaded last
# and would silently override the other.
#############################################

# --- Application versions ---
WATCHER_VERSION=latest
SEARX_VERSION=latest
CERTSTREAM_VERSION=v1.8.2
DB_WATCHER_VERSION=8.0.40
TRAEFIK_VERSION=v3.5

# --- Application ports ---
WATCHER_PORT=9020
DB_WATCHER_PORT=3306

# --- Network Configuration ---
DOMAIN_CORP=your.corporate.domain
NETWORK_NAME=watcher_net
NETWORK_SUBNET=172.20.0.0/16
NETWORK_GATEWAY=172.20.0.1
NETWORK_IP_RANGE=172.20.0.0/24

# --- Database ---
# SECURITY WARNING: change DB_PASSWORD and DB_ROOT_PASSWORD in production.
# WARNING: credentials only apply on the FIRST database init. Changing them
# afterwards requires wiping ../db_watcher/data (and losing all data).
DB_NAME=db_watcher
DB_HOST=db_watcher
DB_PORT=3306
DB_USER=watcher
DB_PASSWORD="password"
DB_ROOT_PASSWORD="rootpassword"

# --- Time zone (containers and Django) ---
TZ=Europe/Paris

# --- SearxNG Configuration ---
# SEARX_COMMAND=-f: automatically update the SearxNG settings to the new version.
# Leave it empty if you made / will make modifications to Searx/searx/settings.yml.
SEARX_COMMAND=-f
SEARX_HOSTNAME=searxng:8080

# --- Container Names ---
DB_CONTAINER=db_watcher
WEB_CONTAINER=watcher
SEARX_CONTAINER=searxng

# --- Application Paths ---
ROOT_PATH=../
WATCHER_PATH=../
SEARX_PATH=../Searx/searx
CA_PATH=./certificates
TRAEFIK_PATH=../traefik

# (Optional proxies)
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost
